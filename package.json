{
	"name": "postgres-js-queue",
	"version": "0.1.1",
	"description": "A minimalist, zero-dependency PostgreSQL queuing library for Node.js",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"postgres-js-queue": "./dist/bin.js"
	},
	"files": [
		"dist",
		"migrations",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "pnpm run build",
		"test": "tsx --test tests/*.test.ts",
		"test:watch": "tsx --test --watch tests/*.test.ts"
	},
	"keywords": [
		"postgres",
		"queue",
		"postgresql",
		"node",
		"minimalist",
		"typescript"
	],
	"author": "Sagi Carmel",
	"license": "MIT",
	"dependencies": {
		"@standard-schema/spec": "^1.0.0"
	},
	"peerDependencies": {
		"postgres": "^3.0.0"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"postgres": "^3.0.0",
		"testcontainers": "^11.14.0",
		"tsx": "^4.21.0",
		"typescript": "^5.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AceCodePt/postgres-js-queue.git"
	}
}
